# Documentation repository: everything is excluded until explicitly allowed.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/WORKFLOW.md
!/requirements-docs.txt
!/docs/
!/scripts/
!/config/
!/skills/
!/.github/
!/.githooks/
!/standards/
/standards/*
!/standards/teruya-dev/
/standards/teruya-dev/*
!/standards/teruya-dev/*.md
!/standards/teruya-dev/*.json
!/standards/teruya-dev/scripts/
!/standards/teruya-dev/references/

# Generated content, binaries, font files, caches and credentials never belong here.
**/node_modules/
**/__pycache__/
**/.venv/
**/output/
**/outputs/
**/exports/
**/downloads/
**/dist/
**/build/
.DS_Store
.env
.env.*
*.pyc
*.mp4
*.mov
*.MOV
*.wav
*.mp3
